# Page renders of the Kohler user guide — 11 MB and fully regenerable from the
# PDF that is committed alongside them. See research/reference/README.md.
research/reference/guide-pages/

# Scratch output
*.tmp
.DS_Store
Thumbs.db

# Root tooling install (oxfmt). The app and viewer ignore their own.
node_modules/

# Rust build output for the replacement controller (controller/).
controller/target/
controller/**/target/

# Emulated-Pi and end-to-end harness scratch output.
controller/.e2e/

# A CA certificate for a development sandbox's TLS-intercepting proxy, copied
# into the build context so the harness image can be built inside one. It is
# environment material, specific to one machine and one session, and belongs in
# no repository. The committed Dockerfile does not reference it.
.ccr-ca.crt
