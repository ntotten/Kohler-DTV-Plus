# Binary files are stored in Git LFS: photos, scope and logic-analyzer
# captures, datasheets, CAD and fabrication outputs. Git keeps a small pointer
# and the file itself lives in LFS storage, so the repository stays small to
# clone as the photos pile up. Text stays in Git, including the generated SVG
# drawings and the KiCad sources, because it diffs and GitHub renders it.
#
# `git lfs install` once per machine before cloning; without it a checkout
# holds pointer files where these should be. `.github/workflows/format.yml`
# fails a pull request that commits one of these outside LFS.

# Pictures
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.heic filter=lfs diff=lfs merge=lfs -text
*.heif filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.bmp filter=lfs diff=lfs merge=lfs -text

# Video and audio
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.m4v filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.m4a filter=lfs diff=lfs merge=lfs -text

# Documents and archives (datasheets, manuals, fabrication packages)
*.pdf filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
*.tar filter=lfs diff=lfs merge=lfs -text
*.gz filter=lfs diff=lfs merge=lfs -text

# Captures: oscilloscope and logic-analyzer data
*.raw filter=lfs diff=lfs merge=lfs -text
*.sal filter=lfs diff=lfs merge=lfs -text
*.wfm filter=lfs diff=lfs merge=lfs -text

# CAD, 3D models and printing
*.stl filter=lfs diff=lfs merge=lfs -text
*.step filter=lfs diff=lfs merge=lfs -text
*.stp filter=lfs diff=lfs merge=lfs -text
*.wrl filter=lfs diff=lfs merge=lfs -text
*.3mf filter=lfs diff=lfs merge=lfs -text
*.f3d filter=lfs diff=lfs merge=lfs -text

# The two web apps serve their public/ folders as they are, so those stay in
# Git: an app must build and show its icons from a clone made without LFS.
app/public/** !filter !diff !merge !text
viewer/public/** !filter !diff !merge !text
